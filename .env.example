# ==============================================================================
# CLEOPATRA AI - ENVIRONMENT CONFIGURATION
# Grand Cleopatra Hotel (Luxor, Egypt)
# ==============================================================================

# AI Provider Selection: 'ollama' (local zero-cost) or 'fallback' (rule-grounded RAG)
AI_PROVIDER=ollama

# Local Ollama Daemon Configuration (Server-side ONLY - never prefix with NEXT_PUBLIC_)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=multilingual-e5-small

# Request Execution Timeouts (milliseconds)
AI_REQUEST_TIMEOUT_MS=15000

# Security & Rate Limiting (in-memory default, interface ready for Redis/Upstash)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000

# Retrieval & Grounding Thresholds (0.0 to 1.0)
AI_RETRIEVAL_THRESHOLD=0.35
AI_MAX_RETRIEVED_CHUNKS=4

# Official Hotel Reception Contact for Handoffs
NEXT_PUBLIC_HOTEL_WHATSAPP=+201003456789
NEXT_PUBLIC_HOTEL_PHONE=+20 100 345 6789
NEXT_PUBLIC_HOTEL_EMAIL=info@grandcleopatrahotelux.com

